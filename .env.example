# Y environment configuration
# From the repo root in CMD, create .env only if it does not already exist:
#   if not exist .env copy .env.example .env
# Fill keys in the root .env; never commit it or put keys in NEXT_PUBLIC_*.
# Restart the API after changing its environment.

# --- Current board capture: Meta reads handwriting; Baseten assesses evidence ---
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
BASETEN_API_KEY=
DECISION_PROVIDER=baseten
BASETEN_DECISION_MODEL=decision-models/baseten-elephant-9b-latest
# Other supported Baseten choices:
#   decision-models/baseten-mammoth-27b-latest
#   decision-models/baseten-joey-2b-latest
# Baseten -latest names are mutable aliases. Assessments remain provisional.
# Native numerical checks need neither key; handwriting requires Meta.

# --- Evidence labels for answered checks (H4/H5) ---
# Default, no setting needed: Muse Spark Open on Baseten with BASETEN_API_KEY; reads learner ink crops.
# Optional overrides. Selection is explicit; there is no fallback to another provider.
# EVIDENCE_LABEL_PROVIDER=spark-open
#   spark-open: Muse Spark Open on Baseten (default)
#   meta:       Muse Spark on MODEL_API_KEY, model muse-spark-1.3 unless EVIDENCE_LABEL_MODEL says otherwise
#   openai:     OpenAI Decisions, gpt-6-luna (not a Meta model; needs OPENAI_API_KEY)
#   baseten:    Elephant via System One (not a Meta model, text only)
# EVIDENCE_LABEL_MODEL=
# EVIDENCE_LABEL_EFFORT=minimal
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Teaching notes at "End session" use Muse Spark Open on Baseten with BASETEN_API_KEY.

# --- Optional alternative decision provider ---
# To use TypeSafe instead: DECISION_PROVIDER=jev and set TYPESAFE_API_KEY.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.14.0

# --- Learning persistence and deployment ---
# Local default: api/data/learning.sqlite3. Shared deployment requires Postgres.
# LEARNING_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Initialize/upgrade tables from CMD at the repo root:
#   api\.venv\Scripts\python.exe api\scripts\learning_preflight.py --init-db
# Deployment settings (leave unset for local HTTP):
# LEARNING_REQUIRE_POSTGRES=1
# LEARNING_COOKIE_SECURE=1

# --- Frontend configuration: set these in web/.env.local or its host ---
# Next.js does not automatically read this root .env for the web application.
# Server-only URL used by saved-board/Practice/Teach proxy:
# LEARNING_API_BASE=http://127.0.0.1:8101
# Or from CMD before starting the frontend:
#   set "LEARNING_API_BASE=http://127.0.0.1:8101"
# Browser URL for legacy health/chat/speech/learner endpoints, if running main:app:
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# The capture-only service does not supply those legacy endpoints.

# --- Existing Teach providers: configure only the provider you select ---
# Meta above is currently the board reader, not a Teach provider.
# Local Ollama defaults (model must already be pulled):
# OLLAMA_HOST=http://localhost:11434
# MODEL_NAME=gemma4:e4b
# MODEL_NAME_EDGE_FT=y-gemma4
# Optional OpenAI teacher (needs OPENAI_API_KEY):
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_EVIDENCE_MODEL=gpt-5.6-terra
# Optional Google teacher (requires: cd api && uv sync --extra cloud):
# GOOGLE_API_KEY=
# CLOUD_MODEL=gemma-4-31b-it

# --- Optional legacy learner and local speech ---
# EMBED_MODEL=nomic-embed-text
# ADAPTER_DEVICE=cuda
# LEARNER_ADAPTER_CHECKPOINT=models/learner-adapter-v1.safetensors
# Optional speech dependencies: cd api && uv sync --extra speech --extra stt
# Avoid speech downloads during startup:
SPEECH_PREFETCH=0
SPEECH_REQUIRE_LOCK=0
# After locking downloaded assets, set SPEECH_REQUIRE_LOCK=1.
# MOONSHINE_VOICE_CACHE=data/tts-assets
# SPEECH_CACHE_DIR=data/speech-cache

# --- Optional main:app deployment settings ---
# SAFETY_ID_SALT=replace-with-a-private-random-value
# CORS_ORIGINS=https://your-domain.com
# ALLOW_VERCEL_PREVIEWS=0
