# Y needs only these two keys. `npm run setup` copies this file to .env; put your keys there and never commit it.
MODEL_API_KEY=
BASETEN_API_KEY=

# Everything below is optional. Leave it out unless you want to change something.

# Choose who labels evidence. Default, with no setting: Muse Spark Open on BASETEN_API_KEY.
# EVIDENCE_LABEL_PROVIDER=meta      # Muse Spark on MODEL_API_KEY
# EVIDENCE_LABEL_MODEL=muse-spark-1.3

# Local database. Default: api/data/learning.sqlite3.
# LEARNING_DATABASE_URL=

# Not a Meta model, and off unless you set it:
# DEEPGRAM_API_KEY=                 # adds two hosted narration voices to the picker
