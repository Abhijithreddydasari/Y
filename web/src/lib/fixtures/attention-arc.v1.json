        ]
      }
    ]
  },
  "turn": {
    "moves": [
      {
        "type": "seg",
        "id": "s1",
        "goal": "Test the sum-normalization idea on numbers"
      },
      {
        "type": "because",
        "refs": [
          "M3",
          "P1"
        ],
        "text": "Last time softmax looked like dividing by the sum; let us test that with numbers."
      },
      {
        "type": "write",
        "text": "Scores [2, 1] versus [20, 10]"
      },
      {
        "type": "predict",
        "q": "Do [2, 1] and [20, 10] get the same softmax weights?",
        "options": [
          "Yes, same ratio",
          "No, [20, 10] is sharper"
        ],
        "answer": "No, [20, 10] is sharper"
      },
      {
        "type": "equation",
        "latex": "\\mathrm{softmax}(z)_i = \\frac{e^{z_i}}{\\sum_j e^{z_j}}"
      },
      {
        "type": "say",
        "text": "Softmax exponentiates first, so multiplying every score by ten widens the gaps."
      },
      {
        "type": "seg",
        "id": "s2",
        "goal": "Connect scale to temperature"
      },
      {
        "type": "because",
        "refs": [
          "N2"
        ],
        "text": "You already read temperature as sharpening or flattening."
      },
      {
        "type": "widget",
        "kind": "attention",
        "spec": "{\"tokens\": [\"the\", \"cat\", \"sat\", \"down\"], \"temp\": 1.0}"
      },
      {
        "type": "equation",
        "latex": "\\mathrm{Attention}(Q,K,V) = \\mathrm{softmax}\\!\\left(\\frac{QK^\\top}{\\sqrt{d_k}}\\right)V"
      },
      {
        "type": "say",
        "text": "Dividing by the square root of d k acts like a temperature that undoes the growth of dot products."
      },
      {
        "type": "check",
        "kind": "mcq",
        "q": "If d_k grows from 16 to 64 without scaling, what happens to the weights?",
        "key": "They get sharper",
        "concept": "scaled_dot_product",
        "dim": "apply",
        "options": [
          "They stay the same",
          "They get sharper",
          "They get flatter"
        ]
      },
      {
        "type": "turn_end",
        "reason": "wait"
      }
    ]
  },
