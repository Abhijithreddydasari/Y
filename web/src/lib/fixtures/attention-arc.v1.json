      },
      {
        "id": "S1",
        "kind": "shaky",
        "concept": "dot_product_variance",
        "text": "Knows variances of independent terms add, but stalls on the variance of a product of two unit-variance components.",
        "evidence": [
          "d4bfbdae-d0d6-5575-9fd9-a6bed14cde0e"
        ]
      },
      {
        "id": "M3",
        "kind": "misconception",
